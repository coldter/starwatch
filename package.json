{
  "name": "starwatch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @starwatch/worker run dev",
    "dev:webui": "pnpm --filter @starwatch/webui run dev",
    "build": "pnpm --filter @starwatch/webui run build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "test": "pnpm -r test",
    "plan": "pnpm --filter @starwatch/worker run plan",
    "deploy": "pnpm build && pnpm --filter @starwatch/worker run deploy"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.82.0",
    "oxfmt": "^0.68.0",
    "oxlint": "1.82.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.4.1"
}
