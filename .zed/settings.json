// Folder-specific settings
//
// For a full list of overridable settings, and general information on folder-specific settings,
// see the documentation: https://zed.dev/docs/configuring-zed#settings-files
//
// Why the "..." token matters:
// `language_servers` is the *complete* list for that language, not a patch. A
// list of only negations (e.g. ["!biome"]) leaves the enabled list empty, so
// every server — including vtsls — is disabled. "..." expands to "the rest of
// the registered servers for this language", so the negations remove just the
// named server. See https://biomejs.dev/reference/zed (Disable biome for a
// particular project).
//
// This repo lints with oxlint and has no eslint, so Zed's eslint server only
// logs `eslint/noLibrary` noise here; `!eslint` removes it.
{
  "languages": {
    "TypeScript": { "language_servers": ["!biome", "!eslint", "..."] },
    "TSX": { "language_servers": ["!biome", "!eslint", "..."] },
    "JavaScript": { "language_servers": ["!biome", "!eslint", "..."] },
    "JSX": { "language_servers": ["!biome", "!eslint", "..."] },
    "JSON": { "language_servers": ["!biome", "..."] },
    "JSONC": { "language_servers": ["!biome", "..."] },
    "CSS": { "language_servers": ["!biome", "..."] },
    "HTML": { "language_servers": ["!biome", "..."] },
    "GraphQL": { "language_servers": ["!biome", "..."] },
    "XML": { "language_servers": ["!biome", "..."] },
    "Svelte": { "language_servers": ["!biome", "..."] },
    "Astro": { "language_servers": ["!biome", "..."] },
    "Vue.js": { "language_servers": ["!biome", "..."] }
  }
}
